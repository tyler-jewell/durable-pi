{
  // Durable pi object: a PiAgent Durable Object with a Workspace and a pi-ai agent loop.
  //
  // The model is DeepSeek (deepseek-flash). Secrets: DEEPSEEK_API_KEY and DPI_TOKEN (see .dev.vars.example).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durable-pi-object",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],

  // Dynamic Workers: the codemode backend mints a fresh Worker per exec through this loader.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Declared so `wrangler types` and deploys know exactly which secrets the Worker needs (see .dev.vars.example).
  "secrets": { "required": ["DEEPSEEK_API_KEY", "DPI_TOKEN", "CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"] },
  "workers_dev": true,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    }
  ]
}
