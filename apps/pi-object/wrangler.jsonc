{
  // Durable pi object: a PiAgent Durable Object with a Workspace and a pi-ai agent loop.
  //
  // The model is Anthropic; its credential is the ANTHROPIC_OAUTH_TOKEN secret (see .dev.vars.example).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durable-pi-object",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat", "experimental"],


  // The workspace shell runs in a Dynamic Worker minted through this.
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    }
  ]
}
