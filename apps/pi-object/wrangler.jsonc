{
  // Durable pi object: a PiAgent Durable Object with a Workspace and a pi-ai agent loop.
  //
  // The model is DeepSeek (deepseek-flash). Secrets: DEEPSEEK_API_KEY and DPI_TOKEN (see .dev.vars.example).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durable-pi-object",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    }
  ]
}
