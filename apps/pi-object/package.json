{
  "name": "@durable-pi/pi-object",
  "type": "module",
  "description": "Durable Object agent: a pi-ai loop in a Durable Object, with a Workspace, DeepSeek and cost telemetry.",
  "scripts": {
    "dev": "cf dev --port 8788",
    "build": "cf build",
    "types": "cf workers types",
    "deploy": "cf deploy",
    "typecheck": "tsc --noEmit",
    "dev:verify": "bash scripts/verify-do.sh",
    "test": "vitest run --config vitest.unit.config.ts && vitest run --config vitest.do.config.ts",
    "e2e": "tsx e2e/e2e.mts",
    "e2e:remote": "tsx e2e/e2e.mts --target=remote",
    "e2e:compare": "tsx e2e/compare.mts",
    "spend-limits": "node scripts/ensure-spend-limits.mjs",
    "spend-limits:check": "node scripts/ensure-spend-limits.mjs --dry-run",
    "artifacts:inventory": "tsx e2e/inventory.mts",
    "e2e:offline": "tsx e2e/e2e.mts --target=offline",
    "artifacts:billing": "tsx e2e/artifacts-billing-check.mts"
  },
  "dependencies": {
    "@cloudflare/computer": "0.11.3",
    "@earendil-works/pi-ai": "1.6.0",
    "@platformatic/vfs": "0.5.0",
    "just-bash": "^3.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@types/node": "^24.10.1",
    "cf": "1.0.0-rc.2",
    "tsx": "4.22.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
