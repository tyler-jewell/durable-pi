# Copy to .env at the repo root. `just net up <id>` copies the keys listed under
# `env_keys` in dpi-network.yaml into each device's ~/.dpi/backend.env.
#
# A device runs ONE model provider (DPI_PROVIDER in backend.env). Set the matching key(s)
# below and list them under `env_keys` in dpi-network.yaml so they reach the device.
#   DPI_PROVIDER=openrouter             → OPENROUTER_API_KEY
#   DPI_PROVIDER=deepseek               → DEEPSEEK_API_KEY
#   DPI_PROVIDER=cloudflare-ai-gateway  → CLOUDFLARE_API_KEY + CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_GATEWAY_ID
#   DPI_PROVIDER=faux                   → no key (free deterministic model, for tests)
OPENROUTER_API_KEY=sk-or-...

# DeepSeek. https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-...

# Cloudflare AI Gateway. https://developers.cloudflare.com/ai-gateway
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_GATEWAY_ID=

# Optional: Jev (jev-damage-control and the proactive demo) picks the first provider whose
# credentials are set, in this order: TYPESAFE_API_KEY → OPENROUTER_API_KEY → Cloudflare
# Workers AI (CLOUDFLARE_API_KEY + CLOUDFLARE_ACCOUNT_ID). Add the keys you use to
# `env_keys` in dpi-network.yaml to send them to your devices.
# TYPESAFE_API_KEY=
#
# Cloudflare Workers AI serves Jev as `typesafe/jev` (not the AI Gateway):
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
#
# Or point Jev at any System One-compatible endpoint (e.g. a local llama.cpp router):
# JEV_BASE_URL=http://127.0.0.1:8080
# JEV_MODEL=jev-latest
# JEV_API_KEY=

# Only for apps/proactive-dpi-demo (text-to-speech announcements). Without it the demo runs silently.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=56bWURjYFHyYyVf490Dp   # any voice in your ElevenLabs account
# ELEVENLABS_MODEL=eleven_v4_turbo
# DPI_READY_SPEECH="Engineer, your Durable Agent Red Team found a production issue, and found the fix. It's waiting on your review."
# DPI_OPENED_SPEECH="Engineer, heads up. Jev flagged a production issue in {service}. A durable agent is investigating."
