# secrets and this machine's device list (template: dpi-network.example.yaml)
dpi-network.yaml
# this machine's Cloudflare host list (template: apps/dpi-mcp/mesh.example.json)
mesh.json
.env
.env.*
!.env.example
**/backend.env

# dependencies and builds
node_modules/
**/dist/
.venv/
__pycache__/

# runtime data (agent databases never belong in git)
**/.durable-pi/
**/.data/
**/workspace/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.lock
!package-lock.json
!uv.lock

# agent scratch space for the e2e scenario (tests/e2e-network.mjs)
/e2e/

# local artifacts
test-results/
tmp/
*.log
.DS_Store

# terraform: local state and per-operator variables (secrets travel by env)
infra/terraform.tfvars
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*

# this machine's llama-server host overlay (template: llama/hosts.example.yaml)
llama/hosts.yaml
